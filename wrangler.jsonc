{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "planners-voting-report",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "vars": {
    "PUBLIC_APP_URL": "http://127.0.0.1:3000",
    "NPU_TEAM_SUBMISSION_EMAIL": "NPUMail@AtlantaGa.Gov",
    "NOTIFICATION_FROM_EMAIL": "NPUMail@AtlantaGa.Gov",
  },
  "d1_databases": [
    {
      "binding": "NPU_REPORTS_DB",
      "database_name": "npu-planners-voting-report",
      "database_id": "af994d19-782f-4293-b5f3-cfcbad9cdf27",
      "migrations_dir": "migrations",
    },
  ],
}
